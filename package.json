{
  "name": "vitals-monorepo",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "concurrently --kill-others --names web,convex --prefix-colors cyan,magenta \"turbo dev\" \"convex dev\"",
    "dev:web": "turbo dev",
    "dev:convex": "convex dev",
    "build": "turbo build",
    "lint": "oxlint && turbo lint && tsc -p convex/tsconfig.json --noEmit",
    "build:marketing": "turbo build --filter=marketing",
    "build:desktop": "turbo build --filter=desktop",
    "dmg": "turbo dmg --filter=desktop",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --filter=marketing",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:deploy": "convex deploy",
    "typecheck": "turbo typecheck",
    "knip": "knip",
    "build:gateway": "turbo build --filter=@vitals/gateway",
    "export:web": "pnpm --filter @vitals/web export"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.2",
    "convex": "^1.42.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "turbo": "^2.10.4",
    "typescript": "catalog:",
    "oxlint": "^1.89.0",
    "knip": "^6.43.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
