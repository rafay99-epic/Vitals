{
  "name": "vitals-monorepo",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names web,convex --prefix-colors cyan,magenta \"turbo dev\" \"convex dev\"",
    "dev:web": "turbo dev",
    "dev:convex": "convex dev",
    "build": "turbo build",
    "lint": "turbo lint && tsc -p convex/tsconfig.json --noEmit",
    "build:website": "turbo build --filter=website",
    "build:desktop": "turbo build --filter=desktop",
    "dmg": "turbo dmg --filter=desktop",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --filter=website",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "convex": "^1.42.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "turbo": "^2.10.0",
    "typescript": "~6.0.2"
  }
}
