{
  "name": "vitals-monorepo",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "build:website": "turbo build --filter=website",
    "build:desktop": "turbo build --filter=desktop",
    "dmg": "turbo dmg --filter=desktop",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --filter=website"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
