{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "dev": {
      "distribution": "internal",
      "channel": "dev",
      "env": {
        "APP_VARIANT": "dev"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "nightly": {
      "distribution": "internal",
      "channel": "nightly",
      "env": {
        "APP_VARIANT": "nightly"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_VARIANT": "stable"
      },
      "android": {
        "credentialsSource": "local"
      }
    }
  }
}
