{
  "name": "@vitals/mobile",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "android:dev": "APP_VARIANT=dev expo prebuild --clean --platform android && APP_VARIANT=dev expo run:android --variant release",
    "android:nightly": "APP_VARIANT=nightly expo prebuild --clean --platform android && APP_VARIANT=nightly expo run:android --variant release",
    "android:stable": "APP_VARIANT=stable expo prebuild --clean --platform android && APP_VARIANT=stable expo run:android --variant release",
    "release:nightly": "scripts/release-nightly.sh",
    "update:dev": "APP_VARIANT=dev npx -y eas-cli@latest update --channel dev --environment development --platform all --message \"$(git log -1 --pretty=%s)\"",
    "update:nightly": "APP_VARIANT=nightly npx -y eas-cli@latest update --channel nightly --environment preview --platform all --message \"$(git log -1 --pretty=%s)\"",
    "update:stable": "APP_VARIANT=stable npx -y eas-cli@latest update --channel production --environment production --platform all --message \"$(git log -1 --pretty=%s)\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@shopify/react-native-skia": "catalog:",
    "@vitals/app": "workspace:*",
    "@vitals/client-runtime": "workspace:*",
    "@vitals/contracts": "workspace:*",
    "@vitals/discovery": "workspace:*",
    "@vitals/shared": "workspace:*",
    "@vitals/tailnet": "workspace:*",
    "@vitals/ui": "workspace:*",
    "expo": "catalog:",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-in-app-updates": "~0.13.0",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.7",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "58.0.15",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-css": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "^26.6.5",
    "@types/react": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~58.0.18",
    "lightningcss": "1.30.1",
    "postcss": "^8.5.6",
    "tailwindcss": "catalog:"
  }
}
