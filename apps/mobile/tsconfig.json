{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "types": []
  },
  "include": [
    "index.ts",
    "src",
    "app.config.ts",
    "nativewind-env.d.ts"
  ]
}
